# ── Server ────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────
MONGO_URI=mongodb+srv://bilalshabbir1101_db_user:P9nr_h5dQdd!taQ@cluster0.rnvilil.mongodb.net/skillforge?retryWrites=true&w=majority&appName=Cluster0

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=skillforge_jwt_super_secret_key_min_32_chars_2024
JWT_EXPIRES_IN=1d

# ── Password Reset ────────────────────────────────────
RESET_TOKEN_SECRET=skillforge_reset_token_secret_key_2024
RESET_TOKEN_EXPIRES_IN=15m

# ── Google OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Frontend URL (for CORS + redirect after OAuth) ────
CLIENT_URL=http://localhost:5173

# ── Email (Nodemailer — Gmail) ────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=YOUR_GMAIL_ADDRESS_HERE
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD_HERE
EMAIL_FROM="SkillForge <noreply@skillforge.com>"

# ── Cloudinary (frontend uploads directly; backend stores URL only) ──
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Quiz Rules ────────────────────────────────────────
QUIZ_MAX_ATTEMPTS=3
QUIZ_RETRY_WAIT_HOURS=24

# ── Admin Seed ────────────────────────────────────────
ADMIN_EMAIL=admin@skillforge.com
ADMIN_PASSWORD=Admin@123456

# ── Lesson Completion Threshold ───────────────────────
LESSON_COMPLETE_THRESHOLD=0.8
